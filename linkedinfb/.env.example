# Database Configuration
# NOTE: Use sqlite+aiosqlite:// for async SQLite support
DATABASE_URL=sqlite+aiosqlite:///./data/social_hub.db

# Security
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Facebook API Configuration (Optional - for testing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# LinkedIn API Configuration (Optional - for testing)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_ACCESS_TOKEN=

# API Version Info
FACEBOOK_API_VERSION=v24.0
LINKEDIN_API_VERSION=202601

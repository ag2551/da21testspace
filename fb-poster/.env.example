# Facebook Page Configuration
# Copy this file to .env and fill in your actual credentials

# Your Facebook Page ID
# Find it at: https://www.facebook.com/your-page-name/about
# Or use Graph API Explorer: GET /me/accounts
FB_PAGE_ID=your_page_id_here

# Your Page Access Token (Long-lived, 60 days)
# Generate at: https://developers.facebook.com/tools/explorer/
# Required permissions: pages_manage_posts, pages_read_engagement
# See README.md for detailed token generation instructions
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

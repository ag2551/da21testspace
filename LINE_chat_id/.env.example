# LINE Bot Credentials
# Get these from LINE Developers Console: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Google API Credentials for ADK
# Get your API key from: https://aistudio.google.com/apikey
# Set up Google Cloud Project: https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Specify ADK model (default: gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-live-001
ADK_MODEL=gemini-2.5-flash
